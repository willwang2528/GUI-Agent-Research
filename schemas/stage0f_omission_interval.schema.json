{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gui-agent-memory.local/schemas/stage0f_omission_interval.schema.json",
  "title": "Stage 0F complete decision-to-deadline omission interval",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_type",
    "schema_version",
    "canonicalization",
    "artifact_id",
    "unit_alias",
    "adjudicated_event_id",
    "required_action_spec_sha256",
    "decision_observation_ordinal",
    "deadline_observation_ordinal",
    "deadline_evidence",
    "source_snapshot_sha256",
    "complete_through_deadline",
    "entries",
    "chain_tip_sha256",
    "frozen_at"
  ],
  "properties": {
    "artifact_type": {
      "const": "omission_interval"
    },
    "schema_version": {
      "$ref": "https://gui-agent-memory.local/schemas/stage0f_common.schema.json#/$defs/schema_version"
    },
    "canonicalization": {
      "$ref": "https://gui-agent-memory.local/schemas/stage0f_common.schema.json#/$defs/canonicalization"
    },
    "artifact_id": {
      "$ref": "https://gui-agent-memory.local/schemas/stage0f_common.schema.json#/$defs/artifact_id"
    },
    "unit_alias": {
      "$ref": "https://gui-agent-memory.local/schemas/stage0f_common.schema.json#/$defs/unit_alias"
    },
    "adjudicated_event_id": {
      "$ref": "https://gui-agent-memory.local/schemas/stage0f_common.schema.json#/$defs/sha256"
    },
    "required_action_spec_sha256": {
      "$ref": "https://gui-agent-memory.local/schemas/stage0f_common.schema.json#/$defs/sha256"
    },
    "decision_observation_ordinal": {
      "$ref": "https://gui-agent-memory.local/schemas/stage0f_common.schema.json#/$defs/observation_ordinal"
    },
    "deadline_observation_ordinal": {
      "$ref": "https://gui-agent-memory.local/schemas/stage0f_common.schema.json#/$defs/observation_ordinal"
    },
    "deadline_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observation_ordinal",
        "content_sha256",
        "deadline_or_commit_reached"
      ],
      "properties": {
        "observation_ordinal": {
          "$ref": "https://gui-agent-memory.local/schemas/stage0f_common.schema.json#/$defs/observation_ordinal"
        },
        "content_sha256": {
          "$ref": "https://gui-agent-memory.local/schemas/stage0f_common.schema.json#/$defs/sha256"
        },
        "deadline_or_commit_reached": {
          "const": true
        }
      }
    },
    "source_snapshot_sha256": {
      "$ref": "https://gui-agent-memory.local/schemas/stage0f_common.schema.json#/$defs/sha256"
    },
    "complete_through_deadline": {
      "const": true
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sequence",
          "observation_ordinal",
          "observed_at",
          "agent_visible_text",
          "normalized_actions",
          "previous_entry_sha256",
          "entry_sha256"
        ],
        "properties": {
          "sequence": {
            "type": "integer",
            "minimum": 0
          },
          "observation_ordinal": {
            "$ref": "https://gui-agent-memory.local/schemas/stage0f_common.schema.json#/$defs/observation_ordinal"
          },
          "observed_at": {
            "$ref": "https://gui-agent-memory.local/schemas/stage0f_common.schema.json#/$defs/timestamp"
          },
          "agent_visible_text": {
            "type": [
              "string",
              "null"
            ]
          },
          "normalized_actions": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "action_ordinal",
                "action_signature",
                "semantic_description",
                "matches_required_action"
              ],
              "properties": {
                "action_ordinal": {
                  "type": "integer",
                  "minimum": 0
                },
                "action_signature": {
                  "type": "string",
                  "pattern": "^ACT-[A-Z0-9-]+$"
                },
                "semantic_description": {
                  "type": "string",
                  "minLength": 1
                },
                "matches_required_action": {
                  "type": "boolean"
                }
              }
            }
          },
          "previous_entry_sha256": {
            "oneOf": [
              {
                "$ref": "https://gui-agent-memory.local/schemas/stage0f_common.schema.json#/$defs/sha256"
              },
              {
                "type": "null"
              }
            ]
          },
          "entry_sha256": {
            "$ref": "https://gui-agent-memory.local/schemas/stage0f_common.schema.json#/$defs/sha256"
          }
        }
      }
    },
    "chain_tip_sha256": {
      "$ref": "https://gui-agent-memory.local/schemas/stage0f_common.schema.json#/$defs/sha256"
    },
    "frozen_at": {
      "$ref": "https://gui-agent-memory.local/schemas/stage0f_common.schema.json#/$defs/timestamp"
    }
  }
}
