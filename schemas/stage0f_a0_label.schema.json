{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gui-agent-memory.local/schemas/stage0f_a0_label.schema.json",
  "title": "Stage 0F A0 frozen normative label",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_type",
    "schema_version",
    "canonicalization",
    "artifact_id",
    "unit_alias",
    "a0_input_ref",
    "p_old",
    "p_new",
    "update_source_evidence",
    "primary_update_source",
    "normative_action_difference",
    "eligible_decision_point",
    "obligation_assessments",
    "affected_obligation_ids",
    "affected_external_object_ids",
    "competing_causes",
    "boundary_location_id",
    "case_id",
    "supporting_a0_raw_label_ids",
    "adjudication_mode",
    "grounding_mode",
    "evidence_class",
    "semantic_verification",
    "mechanical_grounding_contract",
    "required_action_spec",
    "adjudicated_event_preimage",
    "adjudicated_event_id",
    "primary_analysis_eligible",
    "environment_primary_eligible",
    "annotator_alias",
    "frozen_at"
  ],
  "properties": {
    "artifact_type": {
      "const": "a0_label"
    },
    "schema_version": {
      "$ref": "https://gui-agent-memory.local/schemas/stage0f_common.schema.json#/$defs/schema_version"
    },
    "canonicalization": {
      "$ref": "https://gui-agent-memory.local/schemas/stage0f_common.schema.json#/$defs/canonicalization"
    },
    "artifact_id": {
      "$ref": "https://gui-agent-memory.local/schemas/stage0f_common.schema.json#/$defs/artifact_id"
    },
    "unit_alias": {
      "$ref": "https://gui-agent-memory.local/schemas/stage0f_common.schema.json#/$defs/unit_alias"
    },
    "a0_input_ref": {
      "$ref": "https://gui-agent-memory.local/schemas/stage0f_common.schema.json#/$defs/artifact_ref"
    },
    "p_old": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proposition_id",
        "statement",
        "status",
        "evidence_pointer"
      ],
      "properties": {
        "proposition_id": {
          "type": "string",
          "pattern": "^PROP-[A-Z0-9-]+$"
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "pre_update_frozen",
            "old_state_hypothesized"
          ]
        },
        "evidence_pointer": {
          "oneOf": [
            {
              "$ref": "https://gui-agent-memory.local/schemas/stage0f_common.schema.json#/$defs/evidence_pointer"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "p_new": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proposition_id",
        "statement",
        "evidence_pointer"
      ],
      "properties": {
        "proposition_id": {
          "type": "string",
          "pattern": "^PROP-[A-Z0-9-]+$"
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "evidence_pointer": {
          "$ref": "https://gui-agent-memory.local/schemas/stage0f_common.schema.json#/$defs/evidence_pointer"
        }
      }
    },
    "update_source_evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "label",
          "evidence_pointer"
        ],
        "properties": {
          "label": {
            "enum": [
              "world_truth_changed",
              "task_goal_changed",
              "previously_true_fact_newly_revealed",
              "explicit_corrective_feedback",
              "source_unidentifiable"
            ]
          },
          "evidence_pointer": {
            "$ref": "https://gui-agent-memory.local/schemas/stage0f_common.schema.json#/$defs/evidence_pointer"
          }
        }
      }
    },
    "primary_update_source": {
      "enum": [
        "world_truth_changed",
        "task_goal_changed",
        "previously_true_fact_newly_revealed",
        "explicit_corrective_feedback",
        "source_unidentifiable"
      ]
    },
    "normative_action_difference": {
      "type": "string",
      "minLength": 1
    },
    "eligible_decision_point": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observation_ordinal",
        "rule"
      ],
      "properties": {
        "observation_ordinal": {
          "$ref": "https://gui-agent-memory.local/schemas/stage0f_common.schema.json#/$defs/observation_ordinal"
        },
        "rule": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "obligation_assessments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "obligation_id",
          "affected",
          "rationale"
        ],
        "properties": {
          "obligation_id": {
            "type": "string",
            "pattern": "^O-[A-Z0-9-]+$"
          },
          "affected": {
            "type": "boolean"
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "affected_obligation_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^O-[A-Z0-9-]+$"
      }
    },
    "affected_external_object_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "https://gui-agent-memory.local/schemas/stage0f_common.schema.json#/$defs/opaque_id"
      }
    },
    "competing_causes": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "E",
          "O",
          "G",
          "R",
          "P",
          "S",
          "A",
          "V",
          "Environment",
          "EvaluatorTask",
          "BudgetAPI"
        ]
      }
    },
    "boundary_location_id": {
      "$ref": "https://gui-agent-memory.local/schemas/stage0f_common.schema.json#/$defs/sha256"
    },
    "case_id": {
      "$ref": "https://gui-agent-memory.local/schemas/stage0f_common.schema.json#/$defs/sha256"
    },
    "supporting_a0_raw_label_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "https://gui-agent-memory.local/schemas/stage0f_common.schema.json#/$defs/sha256"
      }
    },
    "adjudication_mode": {
      "enum": [
        "consensus",
        "blinded_human_resolution",
        "independent_paths"
      ]
    },
    "grounding_mode": {
      "enum": [
        "mechanical",
        "blinded_human"
      ]
    },
    "evidence_class": {
      "enum": [
        "MECHANICALLY_VERIFIED_TYPED_CLAIM",
        "HUMAN_ADJUDICATED_EVIDENCE"
      ]
    },
    "semantic_verification": {
      "enum": [
        "MECHANICALLY_VERIFIED",
        "NOT_MECHANICALLY_VERIFIED"
      ]
    },
    "mechanical_grounding_contract": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "contract_version",
            "typed_claim_schema_sha256",
            "typed_claim_sha256",
            "verifier_executable_sha256",
            "verifier_result_sha256",
            "frozen_at"
          ],
          "properties": {
            "contract_version": {
              "const": "stage0f-mechanical-grounding-v1"
            },
            "typed_claim_schema_sha256": {
              "$ref": "https://gui-agent-memory.local/schemas/stage0f_common.schema.json#/$defs/sha256"
            },
            "typed_claim_sha256": {
              "$ref": "https://gui-agent-memory.local/schemas/stage0f_common.schema.json#/$defs/sha256"
            },
            "verifier_executable_sha256": {
              "$ref": "https://gui-agent-memory.local/schemas/stage0f_common.schema.json#/$defs/sha256"
            },
            "verifier_result_sha256": {
              "$ref": "https://gui-agent-memory.local/schemas/stage0f_common.schema.json#/$defs/sha256"
            },
            "frozen_at": {
              "$ref": "https://gui-agent-memory.local/schemas/stage0f_common.schema.json#/$defs/timestamp"
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "required_action_spec": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "action_signature",
            "semantic_description",
            "deadline_or_commit_rule",
            "obligation_ids"
          ],
          "properties": {
            "action_signature": {
              "type": "string",
              "pattern": "^ACT-[A-Z0-9-]+$"
            },
            "semantic_description": {
              "type": "string",
              "minLength": 1
            },
            "deadline_or_commit_rule": {
              "type": "string",
              "minLength": 1
            },
            "obligation_ids": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^O-[A-Z0-9-]+$"
              }
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "adjudicated_event_preimage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "serialization",
        "boundary_location_id",
        "p_old_proposition_id",
        "p_new_proposition_id",
        "normative_action_difference_sha256",
        "sorted_obligation_ids",
        "boundary_type",
        "schema_bundle_sha256",
        "codebook_sha256",
        "supporting_a0_raw_label_ids"
      ],
      "properties": {
        "serialization": {
          "const": "stage0f-adjudicated-event-id-v1"
        },
        "boundary_location_id": {
          "$ref": "https://gui-agent-memory.local/schemas/stage0f_common.schema.json#/$defs/sha256"
        },
        "p_old_proposition_id": {
          "type": "string",
          "pattern": "^PROP-[A-Z0-9-]+$"
        },
        "p_new_proposition_id": {
          "type": "string",
          "pattern": "^PROP-[A-Z0-9-]+$"
        },
        "normative_action_difference_sha256": {
          "$ref": "https://gui-agent-memory.local/schemas/stage0f_common.schema.json#/$defs/sha256"
        },
        "sorted_obligation_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^O-[A-Z0-9-]+$"
          }
        },
        "boundary_type": {
          "enum": [
            "action_commit",
            "required_action_omission",
            "artifact_write",
            "derived_computation",
            "block_decision"
          ]
        },
        "schema_bundle_sha256": {
          "$ref": "https://gui-agent-memory.local/schemas/stage0f_common.schema.json#/$defs/sha256"
        },
        "codebook_sha256": {
          "$ref": "https://gui-agent-memory.local/schemas/stage0f_common.schema.json#/$defs/sha256"
        },
        "supporting_a0_raw_label_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "https://gui-agent-memory.local/schemas/stage0f_common.schema.json#/$defs/sha256"
          }
        }
      }
    },
    "adjudicated_event_id": {
      "$ref": "https://gui-agent-memory.local/schemas/stage0f_common.schema.json#/$defs/sha256"
    },
    "primary_analysis_eligible": {
      "type": "boolean"
    },
    "environment_primary_eligible": {
      "type": "boolean"
    },
    "annotator_alias": {
      "$ref": "https://gui-agent-memory.local/schemas/stage0f_common.schema.json#/$defs/opaque_id"
    },
    "frozen_at": {
      "$ref": "https://gui-agent-memory.local/schemas/stage0f_common.schema.json#/$defs/timestamp"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "grounding_mode": {
            "const": "blinded_human"
          }
        },
        "required": [
          "grounding_mode"
        ]
      },
      "then": {
        "properties": {
          "evidence_class": {
            "const": "HUMAN_ADJUDICATED_EVIDENCE"
          },
          "semantic_verification": {
            "const": "NOT_MECHANICALLY_VERIFIED"
          },
          "mechanical_grounding_contract": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "evidence_class": {
            "const": "MECHANICALLY_VERIFIED_TYPED_CLAIM"
          },
          "semantic_verification": {
            "const": "MECHANICALLY_VERIFIED"
          }
        }
      }
    }
  ]
}
