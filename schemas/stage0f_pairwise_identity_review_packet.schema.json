{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gui-agent-memory.local/schemas/stage0f_pairwise_identity_review_packet.schema.json",
  "title": "Stage 0F packet-local conditional identity-review packet draft",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_type",
    "schema_version",
    "canonicalization",
    "artifact_id",
    "packet_alias",
    "pair_alias",
    "context_alias",
    "review_protocol_id",
    "redaction_policy_id",
    "left_identity_view",
    "right_identity_view"
  ],
  "properties": {
    "artifact_type": {
      "const": "pairwise_identity_review_packet"
    },
    "schema_version": {
      "$ref": "https://gui-agent-memory.local/schemas/stage0f_common.schema.json#/$defs/schema_version"
    },
    "canonicalization": {
      "$ref": "https://gui-agent-memory.local/schemas/stage0f_common.schema.json#/$defs/canonicalization"
    },
    "artifact_id": {
      "type": "string",
      "pattern": "^identity-packet-[0-9a-f]{64}$"
    },
    "packet_alias": {
      "$ref": "https://gui-agent-memory.local/schemas/stage0f_common.schema.json#/$defs/sha256"
    },
    "pair_alias": {
      "$ref": "https://gui-agent-memory.local/schemas/stage0f_common.schema.json#/$defs/sha256"
    },
    "context_alias": {
      "$ref": "https://gui-agent-memory.local/schemas/stage0f_common.schema.json#/$defs/sha256"
    },
    "review_protocol_id": {
      "const": "stage0f-isolated-pairwise-identity-review-v1"
    },
    "redaction_policy_id": {
      "const": "stage0f-conditional-identity-redaction-v2"
    },
    "left_identity_view": {
      "$ref": "#/$defs/identity_view"
    },
    "right_identity_view": {
      "$ref": "#/$defs/identity_view"
    }
  },
  "$defs": {
    "identity_view": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "view_alias",
        "evidence_presentations",
        "temporal_interval",
        "atomicity_question_id"
      ],
      "properties": {
        "view_alias": {
          "$ref": "https://gui-agent-memory.local/schemas/stage0f_common.schema.json#/$defs/sha256"
        },
        "evidence_presentations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "evidence_alias",
              "source_observation_ordinal",
              "rendition"
            ],
            "properties": {
              "evidence_alias": {
                "$ref": "https://gui-agent-memory.local/schemas/stage0f_common.schema.json#/$defs/sha256"
              },
              "source_observation_ordinal": {
                "$ref": "https://gui-agent-memory.local/schemas/stage0f_common.schema.json#/$defs/observation_ordinal"
              },
              "rendition": {
                "oneOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "rendition_type",
                      "text"
                    ],
                    "properties": {
                      "rendition_type": {
                        "const": "utf8_text"
                      },
                      "text": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "rendition_type",
                      "reason"
                    ],
                    "properties": {
                      "rendition_type": {
                        "const": "unavailable"
                      },
                      "reason": {
                        "enum": [
                          "agent_visible_text_missing"
                        ]
                      }
                    }
                  }
                ]
              }
            }
          }
        },
        "temporal_interval": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "start_observation_ordinal",
            "end_observation_ordinal"
          ],
          "properties": {
            "start_observation_ordinal": {
              "$ref": "https://gui-agent-memory.local/schemas/stage0f_common.schema.json#/$defs/observation_ordinal"
            },
            "end_observation_ordinal": {
              "$ref": "https://gui-agent-memory.local/schemas/stage0f_common.schema.json#/$defs/observation_ordinal"
            }
          }
        },
        "atomicity_question_id": {
          "const": "stage0f-independent-atomicity-question-v1"
        }
      }
    }
  }
}
