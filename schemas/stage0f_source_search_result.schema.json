{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gui-agent-memory.local/schemas/stage0f_source_search_result.schema.json",
  "title": "Stage 0F synthetic-only auditable source-search result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_type",
    "schema_version",
    "canonicalization",
    "artifact_id",
    "unit_alias",
    "boundary_location_id",
    "searched_scope_item",
    "checked_artifact_refs",
    "result_status",
    "synthetic_test_only",
    "research_evidence",
    "frozen_at"
  ],
  "properties": {
    "artifact_type": {
      "const": "source_search_result"
    },
    "schema_version": {
      "$ref": "https://gui-agent-memory.local/schemas/stage0f_common.schema.json#/$defs/schema_version"
    },
    "canonicalization": {
      "$ref": "https://gui-agent-memory.local/schemas/stage0f_common.schema.json#/$defs/canonicalization"
    },
    "artifact_id": {
      "$ref": "https://gui-agent-memory.local/schemas/stage0f_common.schema.json#/$defs/artifact_id"
    },
    "unit_alias": {
      "$ref": "https://gui-agent-memory.local/schemas/stage0f_common.schema.json#/$defs/unit_alias"
    },
    "boundary_location_id": {
      "$ref": "https://gui-agent-memory.local/schemas/stage0f_common.schema.json#/$defs/sha256"
    },
    "searched_scope_item": {
      "type": "string",
      "minLength": 1
    },
    "checked_artifact_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "https://gui-agent-memory.local/schemas/stage0f_common.schema.json#/$defs/artifact_ref"
      }
    },
    "result_status": {
      "enum": [
        "no_source_found",
        "conflicting_sources",
        "source_bytes_unavailable"
      ]
    },
    "synthetic_test_only": {
      "const": true
    },
    "research_evidence": {
      "const": false
    },
    "frozen_at": {
      "$ref": "https://gui-agent-memory.local/schemas/stage0f_common.schema.json#/$defs/timestamp"
    }
  }
}
