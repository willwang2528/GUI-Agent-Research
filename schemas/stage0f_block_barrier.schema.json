{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gui-agent-memory.local/schemas/stage0f_block_barrier.schema.json",
  "title": "Stage 0F full-block A0-only adjudication barrier",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_type",
    "schema_version",
    "canonicalization",
    "artifact_id",
    "block_id",
    "block_scope",
    "block_frame_ref",
    "location_manifest_ref",
    "expected_unit_scan_count",
    "expected_location_count",
    "expected_adjudicated_event_count",
    "location_freezes",
    "role_registry",
    "role_history_ref",
    "exposure_policy",
    "sealed_by",
    "sealed_at"
  ],
  "properties": {
    "artifact_type": {
      "const": "block_a0_barrier"
    },
    "schema_version": {
      "$ref": "https://gui-agent-memory.local/schemas/stage0f_common.schema.json#/$defs/schema_version"
    },
    "canonicalization": {
      "$ref": "https://gui-agent-memory.local/schemas/stage0f_common.schema.json#/$defs/canonicalization"
    },
    "artifact_id": {
      "$ref": "https://gui-agent-memory.local/schemas/stage0f_common.schema.json#/$defs/artifact_id"
    },
    "block_id": {
      "type": "string",
      "pattern": "^BLOCK-[A-Z0-9-]+$"
    },
    "block_scope": {
      "enum": [
        "ontology_block_a",
        "ontology_block_b",
        "ontology_block_c",
        "confirmatory_holdout",
        "synthetic_test_only"
      ]
    },
    "block_frame_ref": {
      "$ref": "https://gui-agent-memory.local/schemas/stage0f_common.schema.json#/$defs/artifact_ref"
    },
    "location_manifest_ref": {
      "$ref": "https://gui-agent-memory.local/schemas/stage0f_common.schema.json#/$defs/artifact_ref"
    },
    "expected_unit_scan_count": {
      "type": "integer",
      "minimum": 1
    },
    "expected_location_count": {
      "type": "integer",
      "minimum": 0
    },
    "expected_adjudicated_event_count": {
      "type": "integer",
      "minimum": 0
    },
    "location_freezes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "unit_alias",
          "boundary_location_id",
          "a0_input_ref",
          "a0_submissions_ref",
          "a0_raw_label_ids",
          "raw_label_dispositions",
          "case_roster",
          "a0_adjudication_container_ref",
          "adjudicated_events",
          "independent_path_groups",
          "unresolved_records",
          "prefix_chain_tip_sha256",
          "a0_submissions_frozen_at",
          "a0_adjudication_frozen_at"
        ],
        "properties": {
          "unit_alias": {
            "$ref": "https://gui-agent-memory.local/schemas/stage0f_common.schema.json#/$defs/unit_alias"
          },
          "boundary_location_id": {
            "$ref": "https://gui-agent-memory.local/schemas/stage0f_common.schema.json#/$defs/sha256"
          },
          "a0_input_ref": {
            "$ref": "https://gui-agent-memory.local/schemas/stage0f_common.schema.json#/$defs/artifact_ref"
          },
          "a0_submissions_ref": {
            "$ref": "https://gui-agent-memory.local/schemas/stage0f_common.schema.json#/$defs/artifact_ref"
          },
          "a0_raw_label_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "$ref": "https://gui-agent-memory.local/schemas/stage0f_common.schema.json#/$defs/sha256"
            }
          },
          "raw_label_dispositions": {
            "type": "array",
            "items": {
              "$ref": "https://gui-agent-memory.local/schemas/stage0f_block_a0_adjudication.schema.json#/$defs/raw_label_disposition"
            }
          },
          "case_roster": {
            "type": "array",
            "items": {
              "$ref": "https://gui-agent-memory.local/schemas/stage0f_block_a0_adjudication.schema.json#/$defs/case_record"
            }
          },
          "a0_adjudication_container_ref": {
            "$ref": "https://gui-agent-memory.local/schemas/stage0f_common.schema.json#/$defs/artifact_ref"
          },
          "adjudicated_events": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "adjudicated_event_id",
                "case_id",
                "supporting_a0_raw_label_ids",
                "adjudication_mode",
                "grounding_mode",
                "evidence_class",
                "raw_support_adjudication_sha256",
                "frozen_at"
              ],
              "properties": {
                "adjudicated_event_id": {
                  "$ref": "https://gui-agent-memory.local/schemas/stage0f_common.schema.json#/$defs/sha256"
                },
                "case_id": {
                  "$ref": "https://gui-agent-memory.local/schemas/stage0f_common.schema.json#/$defs/sha256"
                },
                "supporting_a0_raw_label_ids": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "$ref": "https://gui-agent-memory.local/schemas/stage0f_common.schema.json#/$defs/sha256"
                  }
                },
                "adjudication_mode": {
                  "enum": [
                    "consensus",
                    "blinded_human_resolution",
                    "independent_paths"
                  ]
                },
                "grounding_mode": {
                  "enum": [
                    "mechanical",
                    "blinded_human"
                  ]
                },
                "evidence_class": {
                  "enum": [
                    "MECHANICALLY_VERIFIED_TYPED_CLAIM",
                    "HUMAN_ADJUDICATED_EVIDENCE"
                  ]
                },
                "raw_support_adjudication_sha256": {
                  "$ref": "https://gui-agent-memory.local/schemas/stage0f_common.schema.json#/$defs/sha256"
                },
                "frozen_at": {
                  "$ref": "https://gui-agent-memory.local/schemas/stage0f_common.schema.json#/$defs/timestamp"
                }
              }
            }
          },
          "independent_path_groups": {
            "type": "array",
            "items": {
              "$ref": "https://gui-agent-memory.local/schemas/stage0f_block_a0_adjudication.schema.json#/$defs/independent_path_group"
            }
          },
          "unresolved_records": {
            "type": "array",
            "items": {
              "$ref": "https://gui-agent-memory.local/schemas/stage0f_block_a0_adjudication.schema.json#/$defs/unresolved_record"
            }
          },
          "prefix_chain_tip_sha256": {
            "$ref": "https://gui-agent-memory.local/schemas/stage0f_common.schema.json#/$defs/sha256"
          },
          "a0_submissions_frozen_at": {
            "$ref": "https://gui-agent-memory.local/schemas/stage0f_common.schema.json#/$defs/timestamp"
          },
          "a0_adjudication_frozen_at": {
            "$ref": "https://gui-agent-memory.local/schemas/stage0f_common.schema.json#/$defs/timestamp"
          }
        }
      }
    },
    "role_registry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "a0_annotator_aliases",
        "a0_adjudicator_aliases",
        "a1_annotator_aliases",
        "stage_b_annotator_aliases",
        "coordinator_aliases",
        "candidate_generator_aliases",
        "reference_aliases",
        "separation_is_permanent"
      ],
      "properties": {
        "a0_annotator_aliases": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {
            "$ref": "https://gui-agent-memory.local/schemas/stage0f_common.schema.json#/$defs/opaque_id"
          }
        },
        "a0_adjudicator_aliases": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "https://gui-agent-memory.local/schemas/stage0f_common.schema.json#/$defs/opaque_id"
          }
        },
        "a1_annotator_aliases": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "https://gui-agent-memory.local/schemas/stage0f_common.schema.json#/$defs/opaque_id"
          }
        },
        "stage_b_annotator_aliases": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "https://gui-agent-memory.local/schemas/stage0f_common.schema.json#/$defs/opaque_id"
          }
        },
        "coordinator_aliases": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "https://gui-agent-memory.local/schemas/stage0f_common.schema.json#/$defs/opaque_id"
          }
        },
        "candidate_generator_aliases": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {
            "$ref": "https://gui-agent-memory.local/schemas/stage0f_common.schema.json#/$defs/opaque_id"
          }
        },
        "reference_aliases": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "https://gui-agent-memory.local/schemas/stage0f_common.schema.json#/$defs/opaque_id"
          }
        },
        "separation_is_permanent": {
          "const": true
        }
      }
    },
    "role_history_ref": {
      "$ref": "https://gui-agent-memory.local/schemas/stage0f_common.schema.json#/$defs/artifact_ref"
    },
    "exposure_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "classification",
        "allowed_roles",
        "public_linkage"
      ],
      "properties": {
        "classification": {
          "const": "coordinator_secret"
        },
        "allowed_roles": {
          "type": "array",
          "prefixItems": [
            {
              "const": "coordinator"
            }
          ],
          "items": false,
          "minItems": 1,
          "maxItems": 1
        },
        "public_linkage": {
          "const": "content_hash_only"
        }
      }
    },
    "sealed_by": {
      "$ref": "https://gui-agent-memory.local/schemas/stage0f_common.schema.json#/$defs/opaque_id"
    },
    "sealed_at": {
      "$ref": "https://gui-agent-memory.local/schemas/stage0f_common.schema.json#/$defs/timestamp"
    }
  }
}
