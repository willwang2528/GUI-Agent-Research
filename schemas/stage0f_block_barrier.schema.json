{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gui-agent-memory.local/schemas/stage0f_block_barrier.schema.json",
  "title": "Stage 0F full-block A0-only adjudication barrier",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_type",
    "schema_version",
    "canonicalization",
    "artifact_id",
    "block_id",
    "block_scope",
    "expected_unit_scan_count",
    "location_manifest_sha256",
    "location_freezes",
    "role_registry",
    "exposure_policy",
    "sealed_by",
    "sealed_at"
  ],
  "properties": {
    "artifact_type": {
      "const": "block_a0_barrier"
    },
    "schema_version": {
      "$ref": "https://gui-agent-memory.local/schemas/stage0f_common.schema.json#/$defs/schema_version"
    },
    "canonicalization": {
      "$ref": "https://gui-agent-memory.local/schemas/stage0f_common.schema.json#/$defs/canonicalization"
    },
    "artifact_id": {
      "$ref": "https://gui-agent-memory.local/schemas/stage0f_common.schema.json#/$defs/artifact_id"
    },
    "block_id": {
      "type": "string",
      "pattern": "^BLOCK-[A-Z0-9-]+$"
    },
    "block_scope": {
      "enum": [
        "ontology_block_a",
        "ontology_block_b",
        "ontology_block_c",
        "confirmatory_holdout",
        "synthetic_test_only"
      ]
    },
    "expected_unit_scan_count": {
      "type": "integer",
      "minimum": 1
    },
    "location_manifest_sha256": {
      "$ref": "https://gui-agent-memory.local/schemas/stage0f_common.schema.json#/$defs/sha256"
    },
    "location_freezes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "unit_alias",
          "boundary_location_id",
          "task_id",
          "hosted_config_id",
          "coordinator_envelope_ref",
          "a0_input_ref",
          "a0_raw_labels_ref",
          "a0_adjudication_ref",
          "adjudicated_event_ids",
          "prefix_chain_tip_sha256",
          "a0_label_frozen_at"
        ],
        "properties": {
          "unit_alias": {
            "$ref": "https://gui-agent-memory.local/schemas/stage0f_common.schema.json#/$defs/unit_alias"
          },
          "boundary_location_id": {
            "$ref": "https://gui-agent-memory.local/schemas/stage0f_common.schema.json#/$defs/sha256"
          },
          "task_id": {
            "type": "string",
            "pattern": "^[0-9]{3}$"
          },
          "hosted_config_id": {
            "$ref": "https://gui-agent-memory.local/schemas/stage0f_common.schema.json#/$defs/opaque_id"
          },
          "coordinator_envelope_ref": {
            "$ref": "https://gui-agent-memory.local/schemas/stage0f_common.schema.json#/$defs/artifact_ref"
          },
          "a0_input_ref": {
            "$ref": "https://gui-agent-memory.local/schemas/stage0f_common.schema.json#/$defs/artifact_ref"
          },
          "a0_raw_labels_ref": {
            "$ref": "https://gui-agent-memory.local/schemas/stage0f_common.schema.json#/$defs/artifact_ref"
          },
          "a0_adjudication_ref": {
            "$ref": "https://gui-agent-memory.local/schemas/stage0f_common.schema.json#/$defs/artifact_ref"
          },
          "adjudicated_event_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "$ref": "https://gui-agent-memory.local/schemas/stage0f_common.schema.json#/$defs/sha256"
            }
          },
          "prefix_chain_tip_sha256": {
            "$ref": "https://gui-agent-memory.local/schemas/stage0f_common.schema.json#/$defs/sha256"
          },
          "a0_label_frozen_at": {
            "$ref": "https://gui-agent-memory.local/schemas/stage0f_common.schema.json#/$defs/timestamp"
          }
        }
      }
    },
    "role_registry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "a0_annotator_aliases",
        "a0_adjudicator_aliases",
        "a1_annotator_aliases",
        "stage_b_annotator_aliases",
        "separation_is_permanent"
      ],
      "properties": {
        "a0_annotator_aliases": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {
            "$ref": "https://gui-agent-memory.local/schemas/stage0f_common.schema.json#/$defs/opaque_id"
          }
        },
        "a0_adjudicator_aliases": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "https://gui-agent-memory.local/schemas/stage0f_common.schema.json#/$defs/opaque_id"
          }
        },
        "a1_annotator_aliases": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "https://gui-agent-memory.local/schemas/stage0f_common.schema.json#/$defs/opaque_id"
          }
        },
        "stage_b_annotator_aliases": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "https://gui-agent-memory.local/schemas/stage0f_common.schema.json#/$defs/opaque_id"
          }
        },
        "separation_is_permanent": {
          "const": true
        }
      }
    },
    "exposure_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "classification",
        "allowed_roles",
        "public_linkage"
      ],
      "properties": {
        "classification": {
          "const": "coordinator_secret"
        },
        "allowed_roles": {
          "type": "array",
          "prefixItems": [
            {
              "const": "coordinator"
            }
          ],
          "items": false,
          "minItems": 1,
          "maxItems": 1
        },
        "public_linkage": {
          "const": "content_hash_only"
        }
      }
    },
    "sealed_by": {
      "$ref": "https://gui-agent-memory.local/schemas/stage0f_common.schema.json#/$defs/opaque_id"
    },
    "sealed_at": {
      "$ref": "https://gui-agent-memory.local/schemas/stage0f_common.schema.json#/$defs/timestamp"
    }
  }
}
