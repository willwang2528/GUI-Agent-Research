{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gui-agent-memory.local/schemas/stage0f_block_a0_adjudication.schema.json",
  "title": "Stage 0F lossless A0 adjudication container",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_type",
    "schema_version",
    "canonicalization",
    "artifact_id",
    "unit_alias",
    "boundary_location_id",
    "a0_input_ref",
    "a0_submissions_ref",
    "raw_label_dispositions",
    "case_roster",
    "events",
    "independent_path_groups",
    "unresolved_records",
    "adjudicator_alias",
    "frozen_at"
  ],
  "properties": {
    "artifact_type": {
      "const": "block_a0_adjudication"
    },
    "schema_version": {
      "$ref": "https://gui-agent-memory.local/schemas/stage0f_common.schema.json#/$defs/schema_version"
    },
    "canonicalization": {
      "$ref": "https://gui-agent-memory.local/schemas/stage0f_common.schema.json#/$defs/canonicalization"
    },
    "artifact_id": {
      "$ref": "https://gui-agent-memory.local/schemas/stage0f_common.schema.json#/$defs/artifact_id"
    },
    "unit_alias": {
      "$ref": "https://gui-agent-memory.local/schemas/stage0f_common.schema.json#/$defs/unit_alias"
    },
    "boundary_location_id": {
      "$ref": "https://gui-agent-memory.local/schemas/stage0f_common.schema.json#/$defs/sha256"
    },
    "a0_input_ref": {
      "$ref": "https://gui-agent-memory.local/schemas/stage0f_common.schema.json#/$defs/artifact_ref"
    },
    "a0_submissions_ref": {
      "$ref": "https://gui-agent-memory.local/schemas/stage0f_common.schema.json#/$defs/artifact_ref"
    },
    "raw_label_dispositions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/raw_label_disposition"
      }
    },
    "case_roster": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/case_record"
      }
    },
    "events": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/adjudicated_event"
      }
    },
    "independent_path_groups": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/independent_path_group"
      }
    },
    "unresolved_records": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/unresolved_record"
      }
    },
    "adjudicator_alias": {
      "$ref": "https://gui-agent-memory.local/schemas/stage0f_common.schema.json#/$defs/opaque_id"
    },
    "frozen_at": {
      "$ref": "https://gui-agent-memory.local/schemas/stage0f_common.schema.json#/$defs/timestamp"
    }
  },
  "$defs": {
    "raw_label_disposition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "a0_raw_label_id",
        "case_id",
        "disposition",
        "adjudication_mode"
      ],
      "properties": {
        "a0_raw_label_id": {
          "$ref": "https://gui-agent-memory.local/schemas/stage0f_common.schema.json#/$defs/sha256"
        },
        "case_id": {
          "$ref": "https://gui-agent-memory.local/schemas/stage0f_common.schema.json#/$defs/sha256"
        },
        "disposition": {
          "enum": [
            "adjudicated_event",
            "rejected",
            "unresolved"
          ]
        },
        "adjudication_mode": {
          "enum": [
            "consensus",
            "blinded_human_resolution",
            "independent_paths",
            "unresolved"
          ]
        },
        "adjudicated_event_id": {
          "$ref": "https://gui-agent-memory.local/schemas/stage0f_common.schema.json#/$defs/sha256"
        },
        "independent_path_group_id": {
          "$ref": "https://gui-agent-memory.local/schemas/stage0f_common.schema.json#/$defs/sha256"
        },
        "independent_path_id": {
          "$ref": "https://gui-agent-memory.local/schemas/stage0f_common.schema.json#/$defs/sha256"
        },
        "unresolved_record_id": {
          "$ref": "https://gui-agent-memory.local/schemas/stage0f_common.schema.json#/$defs/sha256"
        },
        "rejection_reason_code": {
          "enum": [
            "DUPLICATE_WITHIN_ANNOTATOR",
            "OUT_OF_SCOPE_BY_FROZEN_CODEBOOK",
            "MALFORMED_TYPED_CLAIM"
          ]
        },
        "rejection_evidence": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "rule_id",
            "codebook_rule_sha256",
            "evidence_sha256"
          ],
          "properties": {
            "rule_id": {
              "type": "string",
              "minLength": 1
            },
            "codebook_rule_sha256": {
              "$ref": "https://gui-agent-memory.local/schemas/stage0f_common.schema.json#/$defs/sha256"
            },
            "evidence_sha256": {
              "$ref": "https://gui-agent-memory.local/schemas/stage0f_common.schema.json#/$defs/sha256"
            }
          }
        },
        "decided_by": {
          "$ref": "https://gui-agent-memory.local/schemas/stage0f_common.schema.json#/$defs/opaque_id"
        },
        "decision_rule": {
          "type": "string",
          "minLength": 1
        },
        "decided_at": {
          "$ref": "https://gui-agent-memory.local/schemas/stage0f_common.schema.json#/$defs/timestamp"
        }
      }
    },
    "raw_value_hash": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "a0_raw_label_id",
        "value_sha256"
      ],
      "properties": {
        "a0_raw_label_id": {
          "$ref": "https://gui-agent-memory.local/schemas/stage0f_common.schema.json#/$defs/sha256"
        },
        "value_sha256": {
          "$ref": "https://gui-agent-memory.local/schemas/stage0f_common.schema.json#/$defs/sha256"
        }
      }
    },
    "frozen_transform": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "transform_id",
        "executable_sha256",
        "input_values_sha256",
        "output_value_sha256"
      ],
      "properties": {
        "transform_id": {
          "const": "sorted_set_union_utf8_v1"
        },
        "executable_sha256": {
          "$ref": "https://gui-agent-memory.local/schemas/stage0f_common.schema.json#/$defs/sha256"
        },
        "input_values_sha256": {
          "$ref": "https://gui-agent-memory.local/schemas/stage0f_common.schema.json#/$defs/sha256"
        },
        "output_value_sha256": {
          "$ref": "https://gui-agent-memory.local/schemas/stage0f_common.schema.json#/$defs/sha256"
        }
      }
    },
    "field_resolution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "field",
        "raw_value_hashes",
        "resolution_type",
        "resolved_value",
        "resolved_value_sha256",
        "adjudicator_alias",
        "resolution_rule",
        "resolved_at"
      ],
      "properties": {
        "field": {
          "enum": [
            "p_old_proposition_id",
            "p_new_proposition_id",
            "update_source_labels",
            "normative_action_difference",
            "affected_obligation_ids",
            "boundary_type"
          ]
        },
        "raw_value_hashes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/raw_value_hash"
          }
        },
        "resolution_type": {
          "enum": [
            "exact_consensus",
            "select_raw_value",
            "frozen_deterministic_transform",
            "independent_path_value"
          ]
        },
        "resolved_value": true,
        "resolved_value_sha256": {
          "$ref": "https://gui-agent-memory.local/schemas/stage0f_common.schema.json#/$defs/sha256"
        },
        "selected_raw_label_id": {
          "$ref": "https://gui-agent-memory.local/schemas/stage0f_common.schema.json#/$defs/sha256"
        },
        "frozen_transform": {
          "$ref": "#/$defs/frozen_transform"
        },
        "adjudicator_alias": {
          "$ref": "https://gui-agent-memory.local/schemas/stage0f_common.schema.json#/$defs/opaque_id"
        },
        "resolution_rule": {
          "type": "string",
          "minLength": 1
        },
        "resolved_at": {
          "$ref": "https://gui-agent-memory.local/schemas/stage0f_common.schema.json#/$defs/timestamp"
        }
      }
    },
    "raw_support_adjudication": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule_id",
        "field_resolutions",
        "adjudicated_semantic_projection_sha256",
        "resolved_at"
      ],
      "properties": {
        "rule_id": {
          "const": "stage0f-a0-raw-support-adjudication-v2"
        },
        "field_resolutions": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "items": {
            "$ref": "#/$defs/field_resolution"
          }
        },
        "adjudicated_semantic_projection_sha256": {
          "$ref": "https://gui-agent-memory.local/schemas/stage0f_common.schema.json#/$defs/sha256"
        },
        "resolved_at": {
          "$ref": "https://gui-agent-memory.local/schemas/stage0f_common.schema.json#/$defs/timestamp"
        }
      }
    },
    "source_resolution": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status"
          ],
          "properties": {
            "status": {
              "const": "identified"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "reason_code",
            "searched_scope_roster",
            "searched_scope_sha256",
            "search_result_refs"
          ],
          "properties": {
            "status": {
              "const": "source_unidentifiable"
            },
            "reason_code": {
              "enum": [
                "NO_CUTOFF_SOURCE_AFTER_FROZEN_SEARCH",
                "CONFLICTING_CUTOFF_SOURCES_AFTER_FROZEN_SEARCH",
                "SOURCE_BYTES_UNAVAILABLE_AFTER_FROZEN_SEARCH"
              ]
            },
            "searched_scope_roster": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "searched_scope_sha256": {
              "$ref": "https://gui-agent-memory.local/schemas/stage0f_common.schema.json#/$defs/sha256"
            },
            "search_result_refs": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "artifact_ref",
                  "relative_path"
                ],
                "properties": {
                  "artifact_ref": {
                    "$ref": "https://gui-agent-memory.local/schemas/stage0f_common.schema.json#/$defs/artifact_ref"
                  },
                  "relative_path": {
                    "$ref": "https://gui-agent-memory.local/schemas/stage0f_common.schema.json#/$defs/relative_path"
                  }
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "invalidity_reason"
          ],
          "properties": {
            "status": {
              "const": "invalid_source_measurement"
            },
            "invalidity_reason": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "adjudicated_event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "adjudicated_event_id",
        "case_id",
        "a0_label_ref",
        "a0_label_relative_path",
        "supporting_a0_raw_label_ids",
        "adjudication_mode",
        "grounding_mode",
        "analysis_role",
        "raw_support_adjudication",
        "source_resolution"
      ],
      "properties": {
        "adjudicated_event_id": {
          "$ref": "https://gui-agent-memory.local/schemas/stage0f_common.schema.json#/$defs/sha256"
        },
        "case_id": {
          "$ref": "https://gui-agent-memory.local/schemas/stage0f_common.schema.json#/$defs/sha256"
        },
        "a0_label_ref": {
          "$ref": "https://gui-agent-memory.local/schemas/stage0f_common.schema.json#/$defs/artifact_ref"
        },
        "a0_label_relative_path": {
          "$ref": "https://gui-agent-memory.local/schemas/stage0f_common.schema.json#/$defs/relative_path"
        },
        "supporting_a0_raw_label_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "https://gui-agent-memory.local/schemas/stage0f_common.schema.json#/$defs/sha256"
          }
        },
        "adjudication_mode": {
          "enum": [
            "consensus",
            "blinded_human_resolution",
            "independent_paths"
          ]
        },
        "independent_path_group_id": {
          "$ref": "https://gui-agent-memory.local/schemas/stage0f_common.schema.json#/$defs/sha256"
        },
        "independent_path_id": {
          "$ref": "https://gui-agent-memory.local/schemas/stage0f_common.schema.json#/$defs/sha256"
        },
        "grounding_mode": {
          "enum": [
            "mechanical",
            "blinded_human"
          ]
        },
        "analysis_role": {
          "enum": [
            "primary",
            "sensitivity_only"
          ]
        },
        "raw_support_adjudication": {
          "$ref": "#/$defs/raw_support_adjudication"
        },
        "source_resolution": {
          "$ref": "#/$defs/source_resolution"
        }
      }
    },
    "independent_path_group": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path_group_id",
        "case_id",
        "adjudication_mode",
        "raw_label_ids",
        "event_ids",
        "path_ids",
        "resolution_status",
        "adjudicator_alias",
        "resolution_rule",
        "frozen_at"
      ],
      "properties": {
        "path_group_id": {
          "$ref": "https://gui-agent-memory.local/schemas/stage0f_common.schema.json#/$defs/sha256"
        },
        "case_id": {
          "$ref": "https://gui-agent-memory.local/schemas/stage0f_common.schema.json#/$defs/sha256"
        },
        "adjudication_mode": {
          "const": "independent_paths"
        },
        "raw_label_ids": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {
            "$ref": "https://gui-agent-memory.local/schemas/stage0f_common.schema.json#/$defs/sha256"
          }
        },
        "event_ids": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {
            "$ref": "https://gui-agent-memory.local/schemas/stage0f_common.schema.json#/$defs/sha256"
          }
        },
        "path_ids": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {
            "$ref": "https://gui-agent-memory.local/schemas/stage0f_common.schema.json#/$defs/sha256"
          }
        },
        "resolution_status": {
          "const": "independent_unmerged_paths"
        },
        "adjudicator_alias": {
          "$ref": "https://gui-agent-memory.local/schemas/stage0f_common.schema.json#/$defs/opaque_id"
        },
        "resolution_rule": {
          "type": "string",
          "minLength": 1
        },
        "frozen_at": {
          "$ref": "https://gui-agent-memory.local/schemas/stage0f_common.schema.json#/$defs/timestamp"
        }
      }
    },
    "unresolved_field": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "field",
        "raw_value_hashes"
      ],
      "properties": {
        "field": {
          "enum": [
            "p_old_proposition_id",
            "p_new_proposition_id",
            "update_source_labels",
            "normative_action_difference",
            "affected_obligation_ids",
            "boundary_type"
          ]
        },
        "raw_value_hashes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/raw_value_hash"
          }
        }
      }
    },
    "unresolved_record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unresolved_record_id",
        "case_id",
        "adjudication_mode",
        "raw_label_ids",
        "unresolved_fields",
        "reason_code",
        "adjudicator_alias",
        "resolution_rule",
        "frozen_at"
      ],
      "properties": {
        "unresolved_record_id": {
          "$ref": "https://gui-agent-memory.local/schemas/stage0f_common.schema.json#/$defs/sha256"
        },
        "case_id": {
          "$ref": "https://gui-agent-memory.local/schemas/stage0f_common.schema.json#/$defs/sha256"
        },
        "adjudication_mode": {
          "const": "unresolved"
        },
        "raw_label_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "https://gui-agent-memory.local/schemas/stage0f_common.schema.json#/$defs/sha256"
          }
        },
        "unresolved_fields": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/unresolved_field"
          }
        },
        "reason_code": {
          "enum": [
            "NO_PREREGISTERED_RESOLUTION",
            "ADJUDICATOR_ABSTAINED",
            "FROZEN_TRANSFORM_UNAVAILABLE"
          ]
        },
        "adjudicator_alias": {
          "$ref": "https://gui-agent-memory.local/schemas/stage0f_common.schema.json#/$defs/opaque_id"
        },
        "resolution_rule": {
          "type": "string",
          "minLength": 1
        },
        "frozen_at": {
          "$ref": "https://gui-agent-memory.local/schemas/stage0f_common.schema.json#/$defs/timestamp"
        }
      }
    },
    "case_record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "raw_label_ids",
        "adjudication_mode",
        "case_status",
        "event_ids",
        "required_a1_event_ids",
        "primary_event_id",
        "typed_invalid_raw_label_ids",
        "agreement_status",
        "frozen_at"
      ],
      "properties": {
        "case_id": {
          "$ref": "https://gui-agent-memory.local/schemas/stage0f_common.schema.json#/$defs/sha256"
        },
        "raw_label_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "https://gui-agent-memory.local/schemas/stage0f_common.schema.json#/$defs/sha256"
          }
        },
        "adjudication_mode": {
          "enum": [
            "consensus",
            "blinded_human_resolution",
            "independent_paths",
            "unresolved"
          ]
        },
        "case_status": {
          "enum": [
            "resolved_event",
            "independent_unmerged_paths",
            "unresolved",
            "typed_invalid"
          ]
        },
        "event_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "https://gui-agent-memory.local/schemas/stage0f_common.schema.json#/$defs/sha256"
          }
        },
        "required_a1_event_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "https://gui-agent-memory.local/schemas/stage0f_common.schema.json#/$defs/sha256"
          }
        },
        "primary_event_id": {
          "oneOf": [
            {
              "$ref": "https://gui-agent-memory.local/schemas/stage0f_common.schema.json#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "typed_invalid_raw_label_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "https://gui-agent-memory.local/schemas/stage0f_common.schema.json#/$defs/sha256"
          }
        },
        "agreement_status": {
          "enum": [
            "raw_exact_agreement",
            "raw_substantive_disagreement",
            "single_support_no_agreement",
            "unresolved_disagreement",
            "typed_invalid_not_assessed"
          ]
        },
        "independent_path_group_id": {
          "$ref": "https://gui-agent-memory.local/schemas/stage0f_common.schema.json#/$defs/sha256"
        },
        "unresolved_record_id": {
          "$ref": "https://gui-agent-memory.local/schemas/stage0f_common.schema.json#/$defs/sha256"
        },
        "frozen_at": {
          "$ref": "https://gui-agent-memory.local/schemas/stage0f_common.schema.json#/$defs/timestamp"
        }
      }
    }
  }
}
