{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gui-agent-memory.local/schemas/stage0f_a0_input.schema.json",
  "title": "Stage 0F A0 outcome-blind normative input",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_type",
    "schema_version",
    "canonicalization",
    "artifact_id",
    "source_protocol",
    "unit_alias",
    "coordinator_envelope_commitment_sha256",
    "prefix_commit_log_id",
    "prefix_chain_tip_sha256",
    "boundary_namespace",
    "a0_prefix_payload_sha256",
    "boundary_location_id",
    "agent_visible_instruction",
    "normative_schema",
    "prefix_observations",
    "cutoff_observation_ordinal",
    "candidate_locator",
    "allowed_probes",
    "exposure_class",
    "frozen_at"
  ],
  "properties": {
    "artifact_type": {
      "const": "a0_input"
    },
    "schema_version": {
      "$ref": "https://gui-agent-memory.local/schemas/stage0f_common.schema.json#/$defs/schema_version"
    },
    "canonicalization": {
      "$ref": "https://gui-agent-memory.local/schemas/stage0f_common.schema.json#/$defs/canonicalization"
    },
    "artifact_id": {
      "$ref": "https://gui-agent-memory.local/schemas/stage0f_common.schema.json#/$defs/artifact_id"
    },
    "source_protocol": {
      "const": "stage0f_osworld2_natural_burden_preregistration.md@v0.6"
    },
    "unit_alias": {
      "$ref": "https://gui-agent-memory.local/schemas/stage0f_common.schema.json#/$defs/unit_alias"
    },
    "coordinator_envelope_commitment_sha256": {
      "$ref": "https://gui-agent-memory.local/schemas/stage0f_common.schema.json#/$defs/sha256"
    },
    "prefix_commit_log_id": {
      "$ref": "https://gui-agent-memory.local/schemas/stage0f_common.schema.json#/$defs/artifact_id"
    },
    "prefix_chain_tip_sha256": {
      "$ref": "https://gui-agent-memory.local/schemas/stage0f_common.schema.json#/$defs/sha256"
    },
    "boundary_namespace": {
      "type": "string",
      "pattern": "^stage0f:[a-z0-9._-]+$"
    },
    "a0_prefix_payload_sha256": {
      "$ref": "https://gui-agent-memory.local/schemas/stage0f_common.schema.json#/$defs/sha256"
    },
    "boundary_location_id": {
      "$ref": "https://gui-agent-memory.local/schemas/stage0f_common.schema.json#/$defs/sha256"
    },
    "agent_visible_instruction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text",
        "content_sha256"
      ],
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1
        },
        "content_sha256": {
          "$ref": "https://gui-agent-memory.local/schemas/stage0f_common.schema.json#/$defs/sha256"
        }
      }
    },
    "normative_schema": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "sources",
        "obligations"
      ],
      "properties": {
        "version": {
          "type": "string",
          "minLength": 1
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source_ref_id",
              "source_class",
              "content",
              "content_sha256"
            ],
            "properties": {
              "source_ref_id": {
                "$ref": "https://gui-agent-memory.local/schemas/stage0f_common.schema.json#/$defs/artifact_id"
              },
              "source_class": {
                "enum": [
                  "agent_visible_instruction",
                  "release_tagged_task_schema",
                  "static_app_documentation"
                ]
              },
              "content": {
                "type": "string",
                "minLength": 1
              },
              "content_sha256": {
                "$ref": "https://gui-agent-memory.local/schemas/stage0f_common.schema.json#/$defs/sha256"
              }
            }
          }
        },
        "obligations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "obligation_id",
              "predicate",
              "applicability",
              "deadline_or_commit",
              "source_ref_ids"
            ],
            "properties": {
              "obligation_id": {
                "type": "string",
                "pattern": "^O-[A-Z0-9-]+$"
              },
              "predicate": {
                "type": "string",
                "minLength": 1
              },
              "applicability": {
                "type": "string",
                "minLength": 1
              },
              "deadline_or_commit": {
                "type": "string",
                "minLength": 1
              },
              "source_ref_ids": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "$ref": "https://gui-agent-memory.local/schemas/stage0f_common.schema.json#/$defs/artifact_id"
                }
              }
            }
          }
        }
      }
    },
    "prefix_observations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "observation_ordinal",
          "observed_at",
          "assets",
          "agent_visible_text",
          "normalized_prior_actions",
          "missingness"
        ],
        "properties": {
          "observation_ordinal": {
            "$ref": "https://gui-agent-memory.local/schemas/stage0f_common.schema.json#/$defs/observation_ordinal"
          },
          "observed_at": {
            "$ref": "https://gui-agent-memory.local/schemas/stage0f_common.schema.json#/$defs/timestamp"
          },
          "assets": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "$ref": "https://gui-agent-memory.local/schemas/stage0f_common.schema.json#/$defs/asset_ref"
            }
          },
          "agent_visible_text": {
            "type": [
              "string",
              "null"
            ]
          },
          "normalized_prior_actions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "missingness": {
            "enum": [
              "none",
              "asset_unavailable",
              "source_gap_explicit"
            ]
          }
        }
      }
    },
    "cutoff_observation_ordinal": {
      "$ref": "https://gui-agent-memory.local/schemas/stage0f_common.schema.json#/$defs/observation_ordinal"
    },
    "candidate_locator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "update_observation_ordinal",
        "selection_rule"
      ],
      "properties": {
        "update_observation_ordinal": {
          "$ref": "https://gui-agent-memory.local/schemas/stage0f_common.schema.json#/$defs/observation_ordinal"
        },
        "selection_rule": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "allowed_probes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "probe_id",
          "description",
          "safety",
          "cost_budget"
        ],
        "properties": {
          "probe_id": {
            "$ref": "https://gui-agent-memory.local/schemas/stage0f_common.schema.json#/$defs/opaque_id"
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "safety": {
            "enum": [
              "safe",
              "unsafe",
              "unknown"
            ]
          },
          "cost_budget": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "exposure_class": {
      "const": "a0_normative_only"
    },
    "frozen_at": {
      "$ref": "https://gui-agent-memory.local/schemas/stage0f_common.schema.json#/$defs/timestamp"
    }
  }
}
